                        <li>Kundala / Pagathiya / Nondi</li>
                        <li>Clapping & Singing rhythms</li>
                        <li>Chidiya Udd & Patanguddayan</li>
                        <li>Antakshari & Raja Mantri Chor Sipahi</li>
                    </ul>
                </div>

                <div class="ks-ia-card">
                    <div class="ks-ia-number">04</div>
                    <h4 class="ks-ia-title">Gully Games</h4>
                    <div class="ks-ia-sub">The Lane · 10 Games</div>
                    <ul class="ks-ia-list">
                        <li>Pambaram / Lattu (Spinning tops)</li>
                        <li>Gutte (Pebble tossing)</li>
                        <li>Goli Gundu / Kanche (Marbles)</li>
                        <li>Rope Hopping & Pacha Kuthirai</li>
                    </ul>
                </div>

                <div class="ks-ia-card">
                    <div class="ks-ia-number">05</div>
                    <h4 class="ks-ia-title">Dodge & Tag</h4>
                    <div class="ks-ia-sub">Open Field · 16 Games</div>
                    <ul class="ks-ia-list">
                        <li>Kho-Kho & Kabaddi</li>
                        <li>Kallukoduthan kale vaa</li>
                        <li>Rumal Chor & Vishamrut</li>
                        <li>Langdi & Cheel Jhappata</li>
                    </ul>
                </div>

                <div class="ks-ia-card">
                    <div class="ks-ia-number">06</div>
                    <h4 class="ks-ia-title">Strike & Field</h4>
                    <div class="ks-ia-sub">Open Ground · 5 Games</div>
                    <ul class="ks-ia-list">
                        <li>Gilli Danda (Ancient ball & bat)</li>
                        <li>Chakki Badi & Santhai Katti</li>
                        <li>Khung Kangjei & Mukna Kangjei</li>
                        <li>Sagol Kangjei (Traditional Polo)</li>
                    </ul>
                </div>

                <div class="ks-ia-card">
                    <div class="ks-ia-number">07</div>
                    <h4 class="ks-ia-title">Sports & Skill</h4>
                    <div class="ks-ia-sub">Training Ground · 5 Games</div>
                    <ul class="ks-ia-list">
                        <li>Thoda (Himachali archery sport)</li>
                        <li>Bhalatek (Spear agility)</li>
                        <li>Koogi Chagga (Strength contest)</li>
                        <li>Mushtiyuddha & Yubi Lakpi</li>
                    </ul>
                </div>

                <div class="ks-ia-card">
                    <div class="ks-ia-number">08</div>
                    <h4 class="ks-ia-title">Yoga & Martial</h4>
                    <div class="ks-ia-sub">Akhara Garden · 4 Games</div>
